# ============================================
#  GesAchats - Modèle de configuration (.env.example)
#  Copiez ce fichier en ".env" et remplissez les valeurs.
#  Projet Supabase : ukntkgwtkspyjzrnlmxg  (eu-west-2 / Londres)
# ============================================

# --- Base de données Supabase ---
# CONNEXION RECOMMANDÉE : Shared Pooler (Supavisor) Session Mode - IPv4
# Votre projet n'a PAS l'add-on IPv4 : la connexion directe db.* n'est accessible qu'en IPv6
# (renvoie "aucune donnée du type requise n'a été trouvée" sur un réseau IPv4-only).
# Le Pooler Supavisor est 100% IPv4 et fonctionne sur TOUS les réseaux.
#
# /!\ RÈGLE IMPORTANTE /!\ :
#   Si vous obtenez "(ENOTFOUND) tenant/user postgres.XXX not found" :
#     1. Dashboard Supabase → Settings → Database → Reset database password.
#        Choisissez un mdp SANS le caractère « ; ».
#     2. ATTENDEZ 60-120 s (délai de propagation secret dans Supavisor).
#     3. Bouton Connect → Connection string → C# / ADO.NET → Session pooler (Port 5432).
#     4. Recopiez HOST / PORT / USERNAME / PASSWORD ci-dessous.

# ⚠️ Valeurs EXACTES à récupérer depuis le bouton Connect du Dashboard.
#    Ne recopiez PAS aveuglément aws-0-eu-west-2 : vérifiez la région affichée dans le Dashboard.
SUPABASE_HOST=aws-0-eu-west-2.pooler.supabase.com
SUPABASE_PORT=5432
SUPABASE_DATABASE=postgres
SUPABASE_USERNAME=postgres.ukntkgwtkspyjzrnlmxg
SUPABASE_PASSWORD="COLLEZ_ICI_VOTRE_MOT_DE_PASSE_DB"
SUPABASE_SSL_MODE=Require
SUPABASE_TRUST_CERTIFICATE=true

# --- Alternative N°2 : Pooler aws-1 eu-west-2 (si aws-0 échoue avec "tenant not found") ---
# SUPABASE_HOST=aws-1-eu-west-2.pooler.supabase.com
# SUPABASE_PORT=5432
# SUPABASE_USERNAME=postgres.ukntkgwtkspyjzrnlmxg

# --- Alternative N°3 : Pooler Transaction (eu-west-2 port 6543) ---
# SUPABASE_HOST=aws-0-eu-west-2.pooler.supabase.com
# SUPABASE_PORT=6543

# --- Alternative N°4 : Connexion DIRECTE (IPv6 OU add-on IPv4 payant uniquement) ---
# SUPABASE_HOST=db.ukntkgwtkspyjzrnlmxg.supabase.co
# SUPABASE_PORT=5432
# SUPABASE_USERNAME=postgres

# --- Authentification Supabase (Auth) ---
# URL du projet (Dashboard Supabase → Settings → API)
SUPABASE_URL=https://ukntkgwtkspyjzrnlmxg.supabase.co
# Clé publique "anon" legacy (non secrète) - Dashboard Supabase → Settings → API
SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InVrbnRrZ3d0a3NweWp6cm5sbXhnIiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODU4NzkwMjksImV4cCI6MjEwMTQ1NTAyOX0.irxxC1kNbNhsOnnxN0WVtKhb381DsgsRwgPsUPueJfE"
# Alias recommandé par Supabase pour les clients récents (publishable key)
SUPABASE_PUBLISHABLE_KEY="sb_publishable_lQmhbgHvmovom1vSpYwgdg_Cdpp2NrJ"
# Clé secrète (service_role) - À UTILISER UNIQUEMENT CÔTÉ SERVEUR, JAMAIS DANS UNE APP CLIENT WPF !
# Copiez la valeur depuis Dashboard Supabase → Settings → API → Project API keys → service_role
SUPABASE_SECRET_KEY="sb_secret_COLLEZ_ICI_VOTRE_CLE_SERVICE_ROLE"
# URL de vérification des jetons JWT (JWKS)
SUPABASE_JWKS_URL=https://ukntkgwtkspyjzrnlmxg.supabase.co/auth/v1/.well-known/jwks.json

# --- Compte administrateur (bootstrap) ---
# Email du compte admin (créé s'il n'existe encore aucun administrateur en base,
# sinon l'email de l'admin existant est utilisé).
ADMIN_EMAIL=youssefoularbi628@gmail.com
# Mot de passe du compte administrateur (doit être ≥ 8 caractères pour Supabase Auth)
ADMIN_PASSWORD="Admin2024!Secure"

# --- SMTP (envoi d'emails) ---
# Configuration Gmail : utilisez un « Mot de passe d'application » si 2FA est activé.
# Pour Gmail classique sans 2FA : https://myaccount.google.com/lesssecureapps (⚠️ déconseillé).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=TON_EMAIL@gmail.com
SMTP_PASSWORD="MOT_DE_PASSE_APPLICATION_GMAIL"
SMTP_FROM_EMAIL=TON_EMAIL@gmail.com
SMTP_FROM_NAME="GesAchats"
SMTP_USE_STARTTLS=true
