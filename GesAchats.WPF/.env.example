# ============================================
#  GesAchats - Modèle de configuration (.env.example)
#  Copiez ce fichier en ".env" et remplissez les valeurs.
# ============================================

# --- Base de données Supabase ---
SUPABASE_HOST=aws-1-eu-west-1.pooler.supabase.com
SUPABASE_PORT=5432
SUPABASE_DATABASE=postgres
SUPABASE_USERNAME=postgres.TON_PROJECT_REF
SUPABASE_PASSWORD="TON_MOT_DE_PASSE_DB"
SUPABASE_SSL_MODE=Require
SUPABASE_TRUST_CERTIFICATE=true

# --- Authentification Supabase (Auth) ---
# URL du projet (Dashboard Supabase → Settings → API)
SUPABASE_URL=https://TON_PROJECT_REF.supabase.co
# Clé publique "anon" (non secrète) - Dashboard Supabase → Settings → API
SUPABASE_ANON_KEY=TON_ANON_KEY

# --- Compte administrateur (bootstrap) ---
# Email du compte admin (créé s'il n'existe encore aucun administrateur en base,
# sinon l'email de l'admin existant est utilisé).
ADMIN_EMAIL=admin@gesachats.ma
# Mot de passe Supabase du compte administrateur
ADMIN_PASSWORD=InitialAdmin123!

# --- SMTP (envoi d'emails) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=ton.email@gmail.com
SMTP_PASSWORD="ton_mot_de_passe_application"
SMTP_FROM_EMAIL=ton.email@gmail.com
SMTP_FROM_NAME=GesAchats
SMTP_USE_STARTTLS=true