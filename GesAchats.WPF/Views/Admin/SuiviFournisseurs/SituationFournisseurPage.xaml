<Page x:Class="GesAchats.WPF.Views.Admin.SuiviFournisseurs.SituationFournisseurPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:ctrls="clr-namespace:GesAchats.WPF.Controls"
      xmlns:fa="clr-namespace:FontAwesome.Sharp;assembly=FontAwesome.Sharp"
      mc:Ignorable="d"
      d:DesignHeight="1200" d:DesignWidth="1200"
      Title="Situation Fournisseur">

    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../../../Resources/Comptable/ComptableStyles.xaml"/>
                <ResourceDictionary Source="../../../Resources/Shared/Colors.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="MetricCardStyle" TargetType="Border">
                <Setter Property="Background" Value="White"/>
                <Setter Property="CornerRadius" Value="12"/>
                <Setter Property="Padding" Value="15"/>
                <Setter Property="BorderBrush" Value="#E2E8F0"/>
                <Setter Property="BorderThickness" Value="1"/>
            </Style>

            <Style x:Key="TableHeaderLevel1" TargetType="TextBlock">
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="FontWeight" Value="Bold"/>
                <Setter Property="Foreground" Value="#6C5CE7"/>
                <Setter Property="HorizontalAlignment" Value="Center"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="Padding" Value="8,10"/>
            </Style>

            <Style x:Key="TableHeaderLevel2" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Foreground" Value="#64748B"/>
                <Setter Property="HorizontalAlignment" Value="Center"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="Padding" Value="8,8"/>
            </Style>

            <Style x:Key="TableCell" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="Foreground" Value="#0F172A"/>
                <Setter Property="Padding" Value="8,6"/>
                <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            </Style>

            <Style x:Key="MergedCell" TargetType="TextBlock">
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Foreground" Value="#0F172A"/>
                <Setter Property="Padding" Value="8,6"/>
                <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            </Style>

            <Style x:Key="FilterDateStyle" TargetType="DatePicker">
                <Setter Property="Height" Value="38"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="Background" Value="#FFFFFF"/>
                <Setter Property="BorderBrush" Value="#D0CDE8"/>
                <Setter Property="BorderThickness" Value="1.5"/>
                <Setter Property="HorizontalAlignment" Value="Stretch"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="DatePicker">
                            <Border Background="{TemplateBinding Background}" 
                                    BorderBrush="{TemplateBinding BorderBrush}" 
                                    BorderThickness="{TemplateBinding BorderThickness}" 
                                    CornerRadius="8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <DatePickerTextBox 
                                        x:Name="PART_TextBox" 
                                        Grid.Column="0" 
                                        Foreground="{TemplateBinding Foreground}" 
                                        Background="Transparent" 
                                        BorderThickness="0" 
                                        VerticalContentAlignment="Center" 
                                        Padding="12,0" 
                                        FontSize="{TemplateBinding FontSize}"/>
                                    <Button x:Name="PART_Button" 
                                            Grid.Column="1" 
                                            Width="32" 
                                            Background="Transparent" 
                                            BorderThickness="0" 
                                            Cursor="Hand" 
                                            Focusable="False">
                                        <Path Data="M6 2v2M18 2v2M3 8h18M5 4h14a2 2 0 012 2v14a2 2 0 01-2 2H5a2 2 0 01-2-2V6a2 2 0 012-2z" 
                                              Stroke="#6C5CE7" StrokeThickness="1.5" 
                                              StrokeLineJoin="Round" 
                                              StrokeStartLineCap="Round" 
                                              StrokeEndLineCap="Round" 
                                              Width="16" Height="16" 
                                              Stretch="Uniform"/>
                                    </Button>
                                    <Popup x:Name="PART_Popup" 
                                           AllowsTransparency="True" 
                                           Placement="Bottom" 
                                           IsOpen="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}}">
                                        <Calendar x:Name="PART_Calendar"/>
                                    </Popup>
                                </Grid>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="BtnPrimaryStyle" TargetType="Button">
                <Setter Property="Background" Value="#FFFFFF"/>
                <Setter Property="BorderBrush" Value="#6C5CE7"/>
                <Setter Property="BorderThickness" Value="1.5"/>
                <Setter Property="Foreground" Value="#6C5CE7"/>
                <Setter Property="Height" Value="44"/>
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="FontWeight" Value="Medium"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Padding" Value="16,0"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="8"
                                    Padding="{TemplateBinding Padding}"
                                    RenderTransformOrigin="0.5,0.5">
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="#6C5CE7"/>
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="#6C5CE7"/>
                                    <Setter Property="Foreground" Value="#FFFFFF"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Page.Resources>

    <Grid Background="#F8FAFC">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="24">
<!-- Header -->
                <Grid Margin="0,0,0,24">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="{Binding Title}" FontSize="28" FontWeight="Bold" Foreground="#0F172A"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button Command="{Binding RetourCommand}"
                                    Style="{StaticResource BtnPrimaryStyle}"
                                    Margin="0,0,12,0">
                                <StackPanel Orientation="Horizontal">
                                    <fa:IconImage Icon="ArrowLeft" Width="16" Height="16" Foreground="#6C5CE7" Margin="0,0,8,0"/>
                                    <TextBlock Text="Retour"/>
                                </StackPanel>
                            </Button>
                            <Button Command="{Binding ExporterExcelCommand}"
                                    Style="{StaticResource BtnPrimaryStyle}">
                                <StackPanel Orientation="Horizontal">
                                    <fa:IconImage Icon="FileExcel" Width="16" Height="16" Foreground="#6C5CE7" Margin="0,0,8,0"/>
                                    <TextBlock Text="Exporter Excel"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <Grid Grid.Row="1" Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Période :" FontSize="13" Foreground="#334155" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <DatePicker SelectedDate="{Binding StartDate}"
                                        Style="{StaticResource FilterDateStyle}"
                                        Margin="0,0,12,0"
                                        Width="160"/>
                            <DatePicker SelectedDate="{Binding EndDate}"
                                        Style="{StaticResource FilterDateStyle}"
                                        Margin="0,0,12,0"
                                        Width="160"/>
                            <Button Command="{Binding RefreshCommand}"
                                    Style="{StaticResource BtnPrimaryStyle}">
                                <StackPanel Orientation="Horizontal">
                                    <fa:IconImage Icon="Sync" Width="14" Height="14" Foreground="#6C5CE7" Margin="0,0,8,0"/>
                                    <TextBlock Text="Actualiser"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Grid>

                <!-- 1. KPI Cards -->
                <Grid Margin="0,0,0,24">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <ctrls:KpiCard Grid.Column="0" Margin="0,0,8,0"
                               Title="Total des Commandes"
                               Value="{Binding TotalCommandes}"
                               Icon="CartShopping"
                               IconColor="#3B82F6"
                               TrendText="{Binding TotalCommandesTrend}"
                               IsPositiveTrend="{Binding TotalCommandesIsPositive}"/>
                    <ctrls:KpiCard Grid.Column="1" Margin="4,0,8,0"
                                   Title="Total des Bons de Livraison"
                                   Value="{Binding TotalBls}"
                                   Icon="Truck"
                                   IconColor="#22C55E"
                                   TrendText="{Binding TotalBlsTrend}"
                                   IsPositiveTrend="{Binding TotalBlsIsPositive}"/>
                    <ctrls:KpiCard Grid.Column="2" Margin="4,0,8,0"
                                   Title="Total des Factures"
                                   Value="{Binding TotalFactures}"
                                   Icon="FileInvoice"
                                   IconColor="#F59E0B"
                                   TrendText="{Binding TotalFacturesTrend}"
                                   IsPositiveTrend="{Binding TotalFacturesIsPositive}"/>
                    <ctrls:KpiCard Grid.Column="3" Margin="4,0,8,0"
                                   Title="Total des Règlements"
                                   Value="{Binding TotalReglements}"
                                   Unit="MAD"
                                   Icon="CheckCircle"
                                   IconColor="#10B981"
                                   TrendText="{Binding TotalReglementsTrend}"
                                   IsPositiveTrend="{Binding TotalReglementsIsPositive}"/>
                    <ctrls:KpiCard Grid.Column="4" Margin="4,0,0,0"
                                   Title="Solde à Payer"
                                   Value="{Binding SoldeAPayer}"
                                   Unit="MAD"
                                   Icon="CreditCard"
                                   IconColor="#EF4444"
                                   TrendText="{Binding SoldeAPayerTrend}"
                                   IsPositiveTrend="{Binding SoldeAPayerIsPositive}"/>
                </Grid>

                <!-- Single Table Container -->
                <Border Style="{StaticResource MetricCardStyle}">
                    <StackPanel>
                        <TextBlock Text="Tableau détaillé de situation"
                                   Foreground="#0F172A"
                                   FontWeight="Bold"
                                   FontSize="16"
                                   Margin="0,0,0,16"/>

                        <ScrollViewer HorizontalScrollBarVisibility="Auto" 
                                      VerticalScrollBarVisibility="Auto"
                                      MaxHeight="600">
                            <StackPanel>
                                <!-- Table Headers -->
                                <Grid Background="#F8FAFC">
                                    <Grid.ColumnDefinitions>
                                        <!-- Bon de Commande -->
                                            <ColumnDefinition Width="131"/>
                                            <ColumnDefinition Width="166"/>
                                            <ColumnDefinition Width="263"/>
                                            <ColumnDefinition Width="131"/>
                                            <ColumnDefinition Width="96"/>
                                            <ColumnDefinition Width="140"/>
                                            <ColumnDefinition Width="105"/>
                                            <ColumnDefinition Width="175"/>
                                            <ColumnDefinition Width="175"/>
<!-- Bon de Livraison -->
                                        <ColumnDefinition Width="131"/>
                                        <ColumnDefinition Width="166"/>
                                        <ColumnDefinition Width="263"/>
                                        <ColumnDefinition Width="114"/>
                                        <ColumnDefinition Width="114"/>
                                        <ColumnDefinition Width="96"/>
                                        <ColumnDefinition Width="123"/>
                                        <ColumnDefinition Width="158"/>
                                        <ColumnDefinition Width="158"/>
                                        <!-- Facture -->
                                        <ColumnDefinition Width="131"/>
                                        <ColumnDefinition Width="166"/>
                                        <ColumnDefinition Width="263"/>
                                        <ColumnDefinition Width="158"/>
                                        <ColumnDefinition Width="105"/>
                                        <ColumnDefinition Width="158"/>
                                        <ColumnDefinition Width="158"/>
                                        <!-- Règlements -->
                                        <ColumnDefinition Width="158"/>
                                        <ColumnDefinition Width="140"/>
                                        <ColumnDefinition Width="201"/>
                                        <ColumnDefinition Width="158"/>
                                        <ColumnDefinition Width="158"/>
                                        <ColumnDefinition Width="158"/>
                                        <ColumnDefinition Width="123"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Level 1 Headers -->
                                    <Border Grid.Column="0" Grid.ColumnSpan="9" Background="#F1F0FA" BorderBrush="#E2E8F0" BorderThickness="1">
                                        <TextBlock Text="BON DE COMMANDE" Style="{StaticResource TableHeaderLevel1}"/>
                                    </Border>
                                    <Border Grid.Column="9" Grid.ColumnSpan="9" Background="#F1F0FA" BorderBrush="#E2E8F0" BorderThickness="1">
                                        <TextBlock Text="BON DE LIVRAISON" Style="{StaticResource TableHeaderLevel1}"/>
                                    </Border>
                                    <Border Grid.Column="18" Grid.ColumnSpan="7" Background="#F1F0FA" BorderBrush="#E2E8F0" BorderThickness="1">
                                        <TextBlock Text="FACTURE" Style="{StaticResource TableHeaderLevel1}"/>
                                    </Border>
                                    <Border Grid.Column="25" Grid.ColumnSpan="7" Background="#F1F0FA" BorderBrush="#E2E8F0" BorderThickness="1">
                                        <TextBlock Text="RÈGLEMENTS" Style="{StaticResource TableHeaderLevel1}"/>
                                    </Border>
                                </Grid>

                                <!-- Level 2 Headers -->
                                <Grid Background="#F8FAFC">
                                    <Grid.ColumnDefinitions>
                                        <!-- Bon de Commande -->
                                            <ColumnDefinition Width="131"/>
                                            <ColumnDefinition Width="166"/>
                                            <ColumnDefinition Width="263"/>
                                            <ColumnDefinition Width="131"/>
                                            <ColumnDefinition Width="96"/>
                                            <ColumnDefinition Width="140"/>
                                            <ColumnDefinition Width="105"/>
                                            <ColumnDefinition Width="175"/>
                                            <ColumnDefinition Width="175"/>
<!-- Bon de Livraison -->
                                        <ColumnDefinition Width="131"/>
                                        <ColumnDefinition Width="166"/>
                                        <ColumnDefinition Width="263"/>
                                        <ColumnDefinition Width="114"/>
                                        <ColumnDefinition Width="114"/>
                                        <ColumnDefinition Width="96"/>
                                        <ColumnDefinition Width="123"/>
                                        <ColumnDefinition Width="158"/>
                                        <ColumnDefinition Width="158"/>
                                        <!-- Facture -->
                                        <ColumnDefinition Width="131"/>
                                        <ColumnDefinition Width="166"/>
                                        <ColumnDefinition Width="263"/>
                                        <ColumnDefinition Width="158"/>
                                        <ColumnDefinition Width="105"/>
                                        <ColumnDefinition Width="158"/>
                                        <ColumnDefinition Width="158"/>
                                        <!-- Règlements -->
                                        <ColumnDefinition Width="158"/>
                                        <ColumnDefinition Width="140"/>
                                        <ColumnDefinition Width="201"/>
                                        <ColumnDefinition Width="158"/>
                                        <ColumnDefinition Width="158"/>
                                        <ColumnDefinition Width="158"/>
                                        <ColumnDefinition Width="123"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- BC Columns -->
                                    <Border Grid.Column="0" BorderBrush="#E2E8F0" BorderThickness="1">
                                        <TextBlock Text="N° BC" Style="{StaticResource TableHeaderLevel2}"/>
                                    </Border>
                                    <Border Grid.Column="1" BorderBrush="#E2E8F0" BorderThickness="1">
                                        <TextBlock Text="Date de commande" Style="{StaticResource TableHeaderLevel2}"/>
                                    </Border>
                                    <Border Grid.Column="2" BorderBrush="#E2E8F0" BorderThickness="1">
                                        <TextBlock Text="Désignation" Style="{StaticResource TableHeaderLevel2}"/>
                                    </Border>
                                    <Border Grid.Column="3" BorderBrush="#E2E8F0" BorderThickness="1">
                                        <TextBlock Text="Prix Unitaire" Style="{StaticResource TableHeaderLevel2}"/>
                                    </Border>
                                    <Border Grid.Column="4" BorderBrush="#E2E8F0" BorderThickness="1">
                                        <TextBlock Text="Quantité" Style="{StaticResource TableHeaderLevel2}"/>
                                    </Border>
                                    <Border Grid.Column="5" BorderBrush="#E2E8F0" BorderThickness="1">
                                        <TextBlock Text="Total HT" Style="{StaticResource TableHeaderLevel2}"/>
                                    </Border>
                                    <Border Grid.Column="6" BorderBrush="#E2E8F0" BorderThickness="1">
                                        <TextBlock Text="Total TTC" Style="{StaticResource TableHeaderLevel2}"/>
                                    </Border>
                                    <Border Grid.Column="7" BorderBrush="#E2E8F0" BorderThickness="1">
                                        <TextBlock Text="Total de commande HT" TextWrapping="Wrap" Style="{StaticResource TableHeaderLevel2}"/>
                                    </Border>
                                    <Border Grid.Column="8" BorderBrush="#E2E8F0" BorderThickness="1">
                                        <TextBlock Text="Total de commande TTC" TextWrapping="Wrap" Style="{StaticResource TableHeaderLevel2}"/>
                                    </Border>

                                    <!-- BL Columns -->
                                    <Border Grid.Column="9" BorderBrush="#E2E8F0" BorderThickness="1">
                                        <TextBlock Text="N° BL" Style="{StaticResource TableHeaderLevel2}"/>
                                    </Border>
                                    <Border Grid.Column="10" BorderBrush="#E2E8F0" BorderThickness="1">
                                        <TextBlock Text="Date de livraison" Style="{StaticResource TableHeaderLevel2}"/>
                                    </Border>
                                    <Border Grid.Column="11" BorderBrush="#E2E8F0" BorderThickness="1">
                                        <TextBlock Text="Désignation" Style="{StaticResource TableHeaderLevel2}"/>
                                    </Border>
                                    <Border Grid.Column="12" BorderBrush="#E2E8F0" BorderThickness="1">
                                        <TextBlock Text="Qté Cmd" Style="{StaticResource TableHeaderLevel2}"/>
                                    </Border>
                                    <Border Grid.Column="13" BorderBrush="#E2E8F0" BorderThickness="1">
                                        <TextBlock Text="Qté Livrée" Style="{StaticResource TableHeaderLevel2}"/>
                                    </Border>
                                    <Border Grid.Column="14" BorderBrush="#E2E8F0" BorderThickness="1">
                                        <TextBlock Text="Écart" Style="{StaticResource TableHeaderLevel2}"/>
                                    </Border>
                                    <Border Grid.Column="15" BorderBrush="#E2E8F0" BorderThickness="1">
                                        <TextBlock Text="État" Style="{StaticResource TableHeaderLevel2}"/>
                                    </Border>
                                    <Border Grid.Column="16" BorderBrush="#E2E8F0" BorderThickness="1">
                                        <TextBlock Text="Total de commande TTC" TextWrapping="Wrap" Style="{StaticResource TableHeaderLevel2}"/>
                                    </Border>
                                    <Border Grid.Column="17" BorderBrush="#E2E8F0" BorderThickness="1">
                                        <TextBlock Text="Total de commande HT" TextWrapping="Wrap" Style="{StaticResource TableHeaderLevel2}"/>
                                    </Border>

                                    <!-- Facture Columns -->
                                    <Border Grid.Column="18" BorderBrush="#E2E8F0" BorderThickness="1">
                                        <TextBlock Text="N° Facture" Style="{StaticResource TableHeaderLevel2}"/>
                                    </Border>
                                    <Border Grid.Column="19" BorderBrush="#E2E8F0" BorderThickness="1">
                                        <TextBlock Text="Date de facture" Style="{StaticResource TableHeaderLevel2}"/>
                                    </Border>
                                    <Border Grid.Column="20" BorderBrush="#E2E8F0" BorderThickness="1">
                                        <TextBlock Text="Désignation" Style="{StaticResource TableHeaderLevel2}"/>
                                    </Border>
                                    <Border Grid.Column="21" BorderBrush="#E2E8F0" BorderThickness="1">
                                        <TextBlock Text="Montant HT" Style="{StaticResource TableHeaderLevel2}"/>
                                    </Border>
                                    <Border Grid.Column="22" BorderBrush="#E2E8F0" BorderThickness="1">
                                        <TextBlock Text="TVA" Style="{StaticResource TableHeaderLevel2}"/>
                                    </Border>
                                    <Border Grid.Column="23" BorderBrush="#E2E8F0" BorderThickness="1">
                                        <TextBlock Text="Montant TTC" Style="{StaticResource TableHeaderLevel2}"/>
                                    </Border>
                                    <Border Grid.Column="24" BorderBrush="#E2E8F0" BorderThickness="1">
                                        <TextBlock Text="Total Facture" Style="{StaticResource TableHeaderLevel2}"/>
                                    </Border>

                                    <!-- Règlements Columns -->
                                    <Border Grid.Column="25" BorderBrush="#E2E8F0" BorderThickness="1">
                                        <TextBlock Text="Date" Style="{StaticResource TableHeaderLevel2}"/>
                                    </Border>
                                    <Border Grid.Column="26" BorderBrush="#E2E8F0" BorderThickness="1">
                                        <TextBlock Text="Mode" Style="{StaticResource TableHeaderLevel2}"/>
                                    </Border>
                                    <Border Grid.Column="27" BorderBrush="#E2E8F0" BorderThickness="1">
                                        <TextBlock Text="Référence" Style="{StaticResource TableHeaderLevel2}"/>
                                    </Border>
                                    <Border Grid.Column="28" BorderBrush="#E2E8F0" BorderThickness="1">
                                        <TextBlock Text="Montant" Style="{StaticResource TableHeaderLevel2}"/>
                                    </Border>
                                    <Border Grid.Column="29" BorderBrush="#E2E8F0" BorderThickness="1">
                                        <TextBlock Text="Total Réglé" Style="{StaticResource TableHeaderLevel2}"/>
                                    </Border>
                                    <Border Grid.Column="30" BorderBrush="#E2E8F0" BorderThickness="1">
                                        <TextBlock Text="Reste à Payer" Style="{StaticResource TableHeaderLevel2}"/>
                                    </Border>
                                    <Border Grid.Column="31" BorderBrush="#E2E8F0" BorderThickness="1">
                                        <TextBlock Text="Statut" Style="{StaticResource TableHeaderLevel2}"/>
                                    </Border>
                                </Grid>

                                <!-- Operations List -->
                                <ItemsControl ItemsSource="{Binding Operations}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <ctrls:SituationOperationGroupControl OperationGroup="{Binding}" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
</ItemsControl>
                            </StackPanel>
                        </ScrollViewer>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>