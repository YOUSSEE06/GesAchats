<Window x:Class="GesAchats.WPF.Views.ConnectionErrorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Problème de connexion - GesAchats"
        WindowStyle="None"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        Topmost="True"
        Background="Transparent"
        AllowsTransparency="True"
        FontFamily="Segoe UI"
        ShowInTaskbar="True">
    <Border Margin="20"
            CornerRadius="18"
            Background="White"
            BorderBrush="#E5E7EB"
            BorderThickness="1"
            Padding="32,28"
            MaxWidth="520">
        <Border.Effect>
            <DropShadowEffect BlurRadius="30" ShadowDepth="8" Opacity="0.25" Color="#000000"/>
        </Border.Effect>

        <StackPanel>
            <!-- Header -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                <Border Width="52" Height="52" CornerRadius="26" Background="#FEE2E2" Margin="0,0,16,0">
                    <TextBlock Text="⚠" FontSize="28" Foreground="#DC2626" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Problème de connexion" FontSize="20" FontWeight="Bold" Foreground="#1E293B"/>
                    <TextBlock Text="Base de données inaccessible" FontSize="13" Foreground="#64748B"/>
                </StackPanel>
            </StackPanel>

            <!-- Message -->
            <TextBlock Text="La connexion à la base de données a été interrompue ou perdue. Les données affichées peuvent ne plus être à jour."
                       TextWrapping="Wrap" FontSize="14" Foreground="#334155" LineHeight="22" Margin="0,0,0,18"/>

            <!-- Statut -->
            <Border x:Name="StatusBorder" Background="#FEF3C7" CornerRadius="10" Padding="14,10" Margin="0,0,0,22">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Ellipse x:Name="StatusDot" Width="12" Height="12" Fill="#F59E0B" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <TextBlock x:Name="StatusText" Text="Vérification en cours…" FontSize="13" FontWeight="SemiBold" Foreground="#92400E" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock x:Name="StatusMessageText" Text="Connexion en cours…" FontSize="13" Foreground="#92400E" TextWrapping="Wrap" Margin="0,6,0,0"/>
                </StackPanel>
            </Border>

            <!-- Actions -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Actualiser -->
                <Button x:Name="RefreshButton" Grid.Column="0" Click="OnRefreshClick" Cursor="Hand">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="BtnBorder" Background="#F1F5F9" CornerRadius="10" Padding="0,12">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <TextBlock Text="⟳" FontSize="16" Foreground="#334155" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBlock Text="Actualiser" FontSize="14" FontWeight="SemiBold" Foreground="#334155" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="BtnBorder" Property="Background" Value="#E2E8F0"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="BtnBorder" Property="Opacity" Value="0.5"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <!-- Se connecter -->
                <Button x:Name="ConnectButton" Grid.Column="2" Click="OnConnectClick" Cursor="Hand">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="BtnBorder" Background="#1565C0" CornerRadius="10" Padding="0,12">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <TextBlock Text="🔗" FontSize="14" Foreground="White" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBlock Text="Se connecter" FontSize="14" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="BtnBorder" Property="Background" Value="#0D47A1"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="BtnBorder" Property="Opacity" Value="0.5"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>

            <!-- Fermer -->
            <Button Content="Fermer la fenêtre" 
                    Click="OnCloseClick"
                    Background="Transparent"
                    Foreground="#64748B"
                    FontSize="12"
                    HorizontalAlignment="Center"
                    Margin="0,16,0,0"
                    BorderThickness="0"
                    Cursor="Hand"/>
        </StackPanel>
    </Border>
</Window>