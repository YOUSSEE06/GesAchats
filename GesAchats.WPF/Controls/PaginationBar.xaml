<UserControl x:Class="GesAchats.WPF.Controls.PaginationBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             x:Name="Root"
             d:DesignHeight="54" d:DesignWidth="900">
    <UserControl.Resources>
        <Style x:Key="PaginationButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="#64748B"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="MinWidth" Value="34"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#6C5CE7"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#6C5CE7"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Background" Value="#F1F5F9"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#E2E8F0"/>
                                <Setter Property="Foreground" Value="#94A3B8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Border Background="White" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="8" Padding="15,10">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0"
                       Text="{Binding PaginationText, ElementName=Root}"
                       Foreground="#64748B"
                       FontSize="13"
                       VerticalAlignment="Center"/>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Command="{Binding FirstPageCommand, ElementName=Root}"
                        Style="{StaticResource PaginationButtonStyle}"
                        Margin="0,0,6,0">
                    <TextBlock Text="«" FontSize="16" FontWeight="Bold"/>
                </Button>
                <Button Command="{Binding PreviousPageCommand, ElementName=Root}"
                        Style="{StaticResource PaginationButtonStyle}"
                        Margin="0,0,6,0">
                    <TextBlock Text="‹" FontSize="16" FontWeight="Bold"/>
                </Button>

                <Border Grid.Column="1" Background="#EDE9FE" CornerRadius="6" Padding="10,0" Height="34" VerticalAlignment="Center">
                    <TextBlock FontSize="12.5" FontWeight="SemiBold" Foreground="#5A4BD1" VerticalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding TotalPages, ElementName=Root}" Value="0">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                        <TextBlock.Text>
                            <MultiBinding StringFormat="Page {0}/{1}">
                                <Binding Path="CurrentPage" ElementName="Root"/>
                                <Binding Path="TotalPages" ElementName="Root"/>
                            </MultiBinding>
                        </TextBlock.Text>
                    </TextBlock>
                </Border>

                <Button Command="{Binding NextPageCommand, ElementName=Root}"
                        Style="{StaticResource PaginationButtonStyle}"
                        Margin="6,0,6,0">
                    <TextBlock Text="›" FontSize="16" FontWeight="Bold"/>
                </Button>
                <Button Command="{Binding LastPageCommand, ElementName=Root}"
                        Style="{StaticResource PaginationButtonStyle}">
                    <TextBlock Text="»" FontSize="16" FontWeight="Bold"/>
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>